<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.fwbz.patorlPlan.mapper.PlanCameraMapper">

    <!-- 根据计划ID删除关联摄像头 -->
    <delete id="deleteByPlanId">
        DELETE FROM table_plan_camera WHERE plan_id = #{planId}
    </delete>

    <!-- 根据计划ID查询关联摄像头（含摄像头名称） -->
    <select id="selectByPlanId" resultType="org.jeecg.modules.fwbz.patorlPlan.entity.PlanCamera">
        SELECT
            a.id,
            a.plan_id,
            a.index_code,
            b.name AS camera_name
        FROM table_plan_camera a
        LEFT JOIN table_camera_resource b ON a.index_code = b.index_code
        WHERE a.plan_id = #{planId}
    </select>

    <!-- 批量插入关联摄像头 -->
    <insert id="batchInsertCameras">
        INSERT INTO table_plan_camera (plan_id, index_code) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.planId}, #{item.indexCode})
        </foreach>
    </insert>

</mapper>
